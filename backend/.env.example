# ===== Copia este archivo como .env para desarrollo local =====
# En Render NO se sube un .env: estas variables se configuran en el panel.

PORT=5000
NODE_ENV=development

# Local:  postgresql://postgres:TU_CLAVE@localhost:5432/EloteMania
# Neon:   postgresql://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/EloteMania

# Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# URL(s) del frontend permitidas por CORS, separadas por coma, SIN "/" al final.
# Producción: https://tu-proyecto.vercel.app
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Fotos de productos en la nube (Cloudinary). Obligatorio en Render:
# el disco de Render se borra en cada despliegue. Si se dejan vacías se usa /uploads local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=elotemania
